{
  "schema_version": 1,
  "repository": "SemperSupra/usb-edge",
  "display_name": "USB Edge",
  "description": "Read-only USB inventory and hardware observation",
  "visibility": "public",
  "default_branch": "main",
  "primary_languages": [
    "Go",
    "Shell"
  ],
  "topics": [
    "usb",
    "usbip",
    "linux",
    "arm64",
    "edge"
  ],
  "owners": [
    "SemperSupra"
  ],
  "scope": {
    "included": [
      "Read-only USB inventory and hardware observation",
      "Linux/ARM64 endpoint packaging, exporter lifecycle and driver restoration",
      "Fabric adapter consuming authoritative scoped grants"
    ],
    "out_of_scope": [
      "Global lease authority",
      "Fleet scheduler",
      "Unapproved physical hardware operations or private identifiers"
    ]
  },
  "coordination": {
    "system_of_record": "GitHub",
    "policy_document": "AGENTS.md",
    "current_task": "CURRENT_TASK.md",
    "issue_required": true,
    "pull_request_required": true,
    "branch_pattern": "^(agent|feature|fix|docs|ops|chore|test|refactor)/issue-[0-9]+-[a-z0-9][a-z0-9-]*$",
    "direct_agent_push_to_default_branch": false,
    "timestamp_standard": "ISO 8601 UTC",
    "required_identity_fields": [
      "Actor",
      "Session",
      "Branch",
      "State"
    ],
    "cross_repository_rule": "Source owner remains authoritative until accepted cutover. Versioned contracts, linked issues and pinned source; no duplicated work queue."
  },
  "security": {
    "secret_values_allowed_in_repository": false,
    "public_source_only": true,
    "security_policy": "SECURITY.md",
    "logs_must_be_sanitized": true
  },
  "target_github_settings": {
    "status": "PROPOSED_NOT_APPLIED",
    "default_branch": "main",
    "require_pull_request": true,
    "require_review": true,
    "block_force_pushes": true,
    "block_deletions": true
  },
  "bootstrap": {
    "issue": 1,
    "authority_state": "DESTINATION_ONLY_NOT_CUTOVER",
    "release": "NO_GO",
    "workflows_installed": false
  }
}
